{
  "name": "chrysalis-cwl",
  "version": "0.1.0",
  "private": true,
  "description": "Chrysalis Web Language (CWL) — language pillar",
  "type": "module",
  "bin": {
    "cwl": "scripts/cwl-cli.mjs"
  },
  "scripts": {
    "cwl": "node scripts/cwl-cli.mjs",
    "check": "node scripts/cwl-cli.mjs check",
    "test:cwl-roundtrip": "node scripts/gate-cwl-roundtrip.mjs",
    "test:cwl-diagnose": "node scripts/gate-cwl-diagnose.mjs",
    "test:cwl-dna-bridge": "node scripts/gate-cwl-dna-bridge.mjs",
    "test:cwl-pin": "node scripts/gate-cwl-pin.mjs",
    "sync:cwl-package-lib": "node scripts/sync-cwl-package-lib.mjs",
    "test:cwl-package-exports": "node scripts/sync-cwl-package-lib.mjs && node scripts/gate-cwl-package-exports.mjs",
    "test:cwl-publish-prep": "node scripts/gate-cwl-publish-prep.mjs",
    "test:cwl-pack": "node scripts/gate-cwl-publish-prep.mjs",
    "test:cwl-lsp-map": "node scripts/gate-cwl-lsp-map.mjs",
    "test:cwl-lsp-server": "node scripts/gate-cwl-lsp-server.mjs",
    "test:language": "npm run sync:cwl-package-lib && npm run test:cwl-roundtrip && npm run test:cwl-diagnose && npm run test:cwl-dna-bridge && npm run test:cwl-pin && npm run test:cwl-package-exports && npm run test:cwl-publish-prep && npm run test:cwl-lsp-map && npm run test:cwl-lsp-server",
    "smoke:ut-spine": "node scripts/smoke-ut-spine.mjs",
    "smoke:ut-spine:helix": "node scripts/smoke-ut-spine.mjs --require-helix",
    "smoke:ut-evidence": "node scripts/ut-evidence-pack.mjs",
    "smoke:ut-evidence:helix": "node scripts/ut-evidence-pack.mjs --require-helix",
    "smoke:cwl-ingest-matrix": "node scripts/smoke-cwl-ingest-matrix.mjs",
    "test:ingest": "npm run smoke:cwl-ingest",
    "test:ingest-roundtrip": "npm run smoke:cwl-ingest && npm run smoke:cwl-emit",
    "test:language:full": "npm run test:language && npm run test:ingest-roundtrip && npm run smoke:cwl-ingest-matrix && npm run smoke:cwl-runtime-matrix",
    "test:cwl-mirrors": "node scripts/gate-cwl-mirrors.mjs",
    "setup:mirrors": "node scripts/setup-convert-mirrors.mjs",
    "fmt:cwl": "node scripts/hub-ingest/cwl-fmt.mjs",
    "sync:convert": "node scripts/sync-to-convert.mjs",
    "test:runtime-cwl": "npm test --prefix packages/runtime-cwl",
    "build:webir": "npm install --prefix packages/webir --ignore-scripts && npm run build --prefix packages/webir",
    "link:webir": "node scripts/link-webir.mjs",
    "smoke:webir": "node scripts/smoke-webir-resolve.mjs",
    "pack:cwl-vsix": "node scripts/pack-cwl-vsix.mjs",
    "smoke:cwl-ingest": "node scripts/smoke-cwl-ingest.mjs",
    "smoke:cwl-emit": "node scripts/smoke-cwl-emit.mjs",
    "smoke:cwl-runtime-gold": "node scripts/smoke-cwl-runtime-gold.mjs",
    "smoke:cwl-runtime-matrix": "node scripts/smoke-cwl-runtime-matrix.mjs"
  }
}
